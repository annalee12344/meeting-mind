# Google Gemini API Key (free: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Model (default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Temperature (lower = more deterministic, good for extraction)
TEMPERATURE=0.1

# Fuzzy match threshold for evidence verification (0-100)
FUZZY_MATCH_THRESHOLD=80

# API Server Configuration
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081
